{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(adb:*)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(./keystore/**)",
      "Read(./local.properties)",
      "Read(./**/google-services.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read f; [[ \"$f\" == *.kt ]] && ktlint -F \"$f\"; } || true"
          }
        ]
      }
    ]
  }
}